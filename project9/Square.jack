class Square {
  field int x, y; // square position
  field int size; // square size

  constructor Square new(int ax, int ay, int asize) {
    let x = ax;
    let y = ay;
    let size = asize;
    do draw();
    return this; //retorna o objeto
  }

  method void draw() {
    do Screen.setColor(true);
    do Screen.drawRectangle(x, y, x+size-1, y+size-1);
    return;
  }

  method void dispose() {
    do Memory.deAlloc(this);
    return;
  }

  method int getXcoord() { return x; }
  method int getYcoord() { return y; }

  method void erase() {
    do Screen.setColor(false);
    do Screen.drawRectangle(x, y, x+size-1, y+size-1); // erases the old image of the rectangle

    return;
  }

  method void setPosition(int ax, int ay) {
    let x = ax;
    let y = ay;
    return;
  }

  method void moveDown() {
    if (y+size < 254) {
      do erase();

      let y = y + 16;
      do draw();
    }

    return;
  }

  method void moveUp() {
    if (y > 15) {
      do erase();

      let y = y - 16;
      do draw();
    }

    return;
  }

  method void moveRight() {
    if (x+size < 381) {
      do erase();

      let x = x + 16;
      do draw();
    }

    return;
  }

  method void moveLeft() {
    if (x > 128) {
      do erase();

      let x = x - 16;
      do draw();
    }

    return;
  }


}
